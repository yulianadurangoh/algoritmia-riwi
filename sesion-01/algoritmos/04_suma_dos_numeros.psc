// Rueda Libre - Ejemplo de la sesión: suma de dos números
// Algoritmo secuencial: leer, operar y mostrar
Algoritmo SumaDosNumeros
	Definir primerNumero, segundoNumero, resultado Como Real;
	
	// Entrada
	Escribir "Primer número:";
	Leer primerNumero;
	Escribir "Segundo número:";
	Leer segundoNumero;
	
	// Proceso
	resultado <- primerNumero + segundoNumero;
	
	// Salida
	Escribir "La suma es: ", resultado;
FinAlgoritmo